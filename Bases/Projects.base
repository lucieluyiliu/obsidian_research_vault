filters:
  and:
    - file.hasTag("project")
    - '!file.hasTag("project/idea")'
views:
  - type: table
    name: Active Projects
    order:
      - file.name
      - status
      - with
      - targetVenue
      - hasTopic
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 300
      note.with: 250
    rowHeight: medium
